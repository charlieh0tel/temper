[Unit]
Description=TEMPer stick on /dev/%I as IIO devices
Documentation=https://github.com/charlieh0tel/temper
# Started by udev for each stick's data interface (60-temper-iio.rules),
# not enabled.  BindsTo= stops it when the stick is unplugged.  The
# IIO devices are linked under /run/temper-iio; settings are in
# /etc/default/temper-iio.  See docs/running.md and docs/daemon.md.
BindsTo=dev-%i.device
After=dev-%i.device

StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=notify
NotifyAccess=main
EnvironmentFile=-/etc/default/temper-iio
ExecStart=/usr/bin/temper-iio --device /dev/%I
# Opened as root and passed as the fd named "uhid"; /dev/uhid stays
# root-only, since it can create keyboards.
OpenFile=/dev/uhid:uhid
WatchdogSec=60s
# 2 is a configuration error and 3 a device that cannot be presented
# (unsupported firmware, another HID temperature or humidity sensor,
# or no IIO devices); retrying fixes neither.  1 is a runtime failure and is retried.
Restart=on-failure
RestartSec=5
RestartPreventExitStatus=2 3

User=temper-iio
Group=temper-iio

# /run/temper-iio comes from tmpfiles.d (temper-iio.conf), so it outlives
# any one instance.
ReadWritePaths=/run/temper-iio

# Not PrivateDevices=: its /dev has no hidraw nodes.  /dev/uhid is
# allowed too, in case the device policy applies to OpenFile=.
DevicePolicy=closed
DeviceAllow=char-hidraw rw
DeviceAllow=/dev/uhid rw

CapabilityBoundingSet=
NoNewPrivileges=yes
# Lock files are created 0600 anyway; nothing the daemon makes needs
# to be readable by others.
UMask=0077
ProtectProc=invisible
ProcSubset=pid
RemoveIPC=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
MemoryDenyWriteExecute=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
