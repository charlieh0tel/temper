#!/bin/sh
# Creates group temper and applies the udev rules to sticks already
# plugged in, which deauthorizes their keyboards and gives their data
# interfaces the group.  The group comes first: udev resolves GROUP=
# names when it reads rules.  See docs/running.md.
set -e

case "$1" in
configure)
    if ! getent group temper >/dev/null; then
        addgroup --system temper
    fi
    udevadm control --reload || true
    for stick in /sys/bus/usb/devices/*; do
        if [ "$(cat "$stick/idVendor" 2>/dev/null)" = 3553 ] &&
            [ "$(cat "$stick/idProduct" 2>/dev/null)" = a001 ]; then
            udevadm trigger --action=add --settle --parent-match="$stick" || true
        fi
    done
    ;;
esac

exit 0
