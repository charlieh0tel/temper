#!/bin/sh
# Creates the service account, /run/tempered, and applies the udev
# rules to sticks already plugged in.  The order matters: udev resolves
# GROUP= names when it reads rules, so the group comes first, and the
# unit's ReadWritePaths= needs /run/tempered before it starts.  See
# docs/running.md.
set -e

case "$1" in
configure)
    if ! getent passwd tempered >/dev/null; then
        adduser --system --group --no-create-home \
            --home /nonexistent \
            --gecos "TEMPerGold IIO daemon" \
            tempered
    fi
    systemd-tmpfiles --create /usr/lib/tmpfiles.d/tempered.conf || true
    systemctl daemon-reload || true
    udevadm control --reload || true
    # Re-add each stick and its interfaces: that deauthorizes the
    # keyboard, gives the data interface its group, and starts the
    # daemon, since udev's SYSTEMD_WANTS acts when a device first
    # becomes active.
    for stick in /sys/bus/usb/devices/*; do
        if [ "$(cat "$stick/idVendor" 2>/dev/null)" = 3553 ] &&
            [ "$(cat "$stick/idProduct" 2>/dev/null)" = a001 ]; then
            udevadm trigger --action=add --parent-match="$stick" || true
        fi
    done
    # An upgrade: running instances pick up the new binary.
    systemctl try-restart 'tempered@*.service' || true
    ;;
esac

exit 0
