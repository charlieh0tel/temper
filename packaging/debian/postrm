#!/bin/sh
# Forgets the udev rules on remove.  Purge also locks the account
# rather than deleting it, as Debian does with system accounts: a
# deleted UID or GID could be reused by another account and inherit
# what still names it, such as a hidraw node's group until replug.
set -e

case "$1" in
remove | purge)
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload || true
    fi
    udevadm control --reload || true
    ;;
esac

case "$1" in
purge)
    rm -rf /run/temper-iio /run/temper-iio-sleep
    if getent passwd temper-iio >/dev/null; then
        usermod --lock --expiredate 1 --shell /usr/sbin/nologin temper-iio || true
    fi
    ;;
esac

exit 0
