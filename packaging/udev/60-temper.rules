# PCsensor TEMPerGold, TEMPerHUM and TEMPer2 (all 3553:a001): access to the
# stick, for the temper tool, smartclock-sensord and temper-iio.  See
# docs/running.md.

# The data interface (USB interface 1): readable and writable by group
# temper, and by the user logged in at the seat (uaccess, applied by
# systemd-logind's 73-seat-late.rules).  usb_id supplies the IDs and
# interface number from the USB ancestors; ATTRS{} keys cannot, since
# all of a rule's parent keys must match one ancestor, and the
# interface number and the IDs live on different ones.  Requiring a USB
# parent keeps out the virtual sensor temper-iio creates, which has the
# same IDs on BUS_VIRTUAL.
ACTION!="remove", SUBSYSTEM=="hidraw", SUBSYSTEMS=="usb", \
  IMPORT{builtin}="usb_id"
ACTION!="remove", SUBSYSTEM=="hidraw", ENV{ID_BUS}=="usb", \
  ENV{ID_VENDOR_ID}=="3553", ENV{ID_MODEL_ID}=="a001", \
  ENV{ID_USB_INTERFACE_NUM}=="01", \
  GROUP="temper", MODE="0660", TAG+="uaccess"

# The boot keyboard (USB interface 0), which can type readings into a
# console when CapsLock or NumLock toggles: deauthorized, so the host
# unbinds it and never binds it again.
ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_interface", \
  ATTR{bInterfaceNumber}=="00", \
  ATTRS{idVendor}=="3553", ATTRS{idProduct}=="a001", \
  ATTR{authorized}="0"
