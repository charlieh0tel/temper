# Starts temper-iio@hidrawN for each PCsensor TEMPerGold or TEMPerHUM
# data interface; the unit BindsTo= the device, so an unplug stops it.
# Access to the stick, and the keyboard's deauthorization, come from
# the temper package's 60-temper.rules.  See docs/running.md.

# usb_id supplies the IDs and interface number; a USB parent keeps out
# the virtual sensor temper-iio itself creates (60-temper.rules).
ACTION!="remove", SUBSYSTEM=="hidraw", SUBSYSTEMS=="usb", \
  IMPORT{builtin}="usb_id"
ACTION!="remove", SUBSYSTEM=="hidraw", ENV{ID_BUS}=="usb", \
  ENV{ID_VENDOR_ID}=="3553", ENV{ID_MODEL_ID}=="a001", \
  ENV{ID_USB_INTERFACE_NUM}=="01", \
  TAG+="systemd", ENV{SYSTEMD_WANTS}+="temper-iio@%k.service"
